# Template for backend/.env (`npm run setup` creates one automatically). Never commit the real .env.

# development | test | production
ENVIRONMENT=development
LOG_LEVEL=INFO

# Postgres. postgres:// and postgresql:// URLs (Supabase, Neon, Render) are accepted.
# Supabase/Neon: use the DIRECT connection string and keep ?sslmode=require.
DATABASE_URL=postgresql+psycopg://water:water@localhost:5433/water

# Comma-separated front-end origins allowed by CORS.
CORS_ORIGINS=http://localhost:5173

# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7

# First-run bootstrap (used once; afterwards manage from the admin panel).
# The Raspberry Pi and the simulator send this value in the X-API-Key header.
INGEST_API_KEY=change-me-ingest-key-at-least-24-chars
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-password

# Rate limits (slowapi syntax)
RATE_LIMIT_PUBLIC=60/minute
RATE_LIMIT_INGEST=600/minute

# Domain behaviour
STALE_AFTER_MINUTES=15
ALERT_DEDUP_MINUTES=30
RETENTION_DAYS=90
